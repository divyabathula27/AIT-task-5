      "source": [
        "\n",
        "graph = {\n",
        "    \"Root\": [\"Branch_Left\", \"Branch_Right\"],\n",
        "\n",
        "    \"Branch_Left\": [\"Child_1\", \"Child_2\"],\n",
        "    \"Branch_Right\": [\"Child_3\", \"Child_4\"],\n",
        "\n",
        "    \"Child_1\": [\"A\", \"B\"],\n",
        "    \"Child_2\": [\"C\", \"D\"],\n",
        "    \"Child_3\": [\"E\", \"F\"],\n",
        "    \"Child_4\": [\"G\", \"H\"],\n",
        "\n",
        "    \"A\": [],\n",
        "    \"B\": [],\n",
        "    \"C\": [],\n",
        "    \"D\": [],\n",
        "    \"E\": [],\n",
        "    \"F\": [],\n",
        "    \"G\": [],\n",
        "    \"H\": []\n",
        "}\n",
        "\n",
        "\n",
        "values = {\n",
        "    \"A\": 3,\n",
        "    \"B\": 5,\n",
        "    \"C\": 2,\n",
        "    \"D\": 9,\n",
        "    \"E\": 12,\n",
        "    \"F\": 5,\n",
        "    \"G\": 23,\n",
        "    \"H\": 23\n",
        "}\n",
        "\n",
        "\n",
        "def minimax(node, depth, is_maximizing_player):\n",
        "    if depth == 0 or len(graph[node]) == 0:\n",
        "        return values[node]\n",
        "\n",
        "    if is_maximizing_player:\n",
        "        best_value = float('-inf')\n",
        "\n",
        "        for child in graph[node]:\n",
        "            value = minimax(\n",
        "                child,\n",
        "                depth - 1,\n",
        "                False\n",
        "            )\n",
        "            best_value = max(best_value, value)\n",
        "\n",
        "        return best_value\n",
        "\n",
        "    else:\n",
        "        best_value = float('inf')\n",
        "\n",
        "        for child in graph[node]:\n",
        "            value = minimax(\n",
        "                child,\n",
        "                depth - 1,\n",
        "                True\n",
        "            )\n",
        "            best_value = min(best_value, value)\n",
        "\n",
        "        return best_value\n",
        "\n",
        "optimal_value = minimax(\n",
        "    \"Root\",\n",
        "    depth=3,\n",
        "    is_maximizing_player=True\n",
        ")\n",
        "\n",
        "print(\"The optimal value at Root is:\", optimal_value)"
      ]
